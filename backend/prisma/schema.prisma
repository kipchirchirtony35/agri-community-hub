datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  OFFICER
  ADMIN
}

enum Unit {
  KG
  BAGS_90KG
  CRATES
  TONNES
  LITRES
}

enum Quality {
  GRADE_A
  GRADE_B
  FAIR
  POOR
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  role      Role      @default(FARMER)
  harvests  Harvest[]
  officer   Officer?
  createdAt DateTime  @default(now())
}

model Harvest {
  id             String   @id @default(uuid())
  farmerId       String
  farmer         User     @relation(fields: [farmerId], references: [id])
  crop           String
  quantity       Float
  unit           Unit
  quantityKg     Float    // Kg-normalised quantity
  harvestDate    DateTime
  county         String
  pricePerUnit   Float?
  quality        Quality  @default(GRADE_A)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Officer {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  fullName       String
  email          String   @unique
  phoneNumber    String
  county         String
  specialisation String
  isActive       Boolean  @default(true) // Soft delete flag
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}